# ── Supabase ───────────────────────────────────────────────────────────────
# From your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never ship to client

# ── Retell ─────────────────────────────────────────────────────────────────
# From your Retell dashboard → API Keys
RETELL_API_KEY=your-retell-api-key
# The agent id you create in Retell (points the web-call button at your agent)
RETELL_AGENT_ID=agent_xxxxxxxx
# Shared secret you set in the Retell webhook config; we verify it on inbound calls
RETELL_WEBHOOK_SECRET=generate-a-random-string

# ── WhatsApp (optional) ─────────────────────────────────────────────────────
# If unset, confirmations are simulated (logged). Set both for real sends.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Eval harness ───────────────────────────────────────────────────────────
# The LLM used for the simulated-patient + LLM-judge in eval (any provider you have)
EVAL_LLM_API_KEY=your-llm-key
# Base URL of the deployed backend the harness should hit (or http://localhost:3000)
CARELINE_BASE_URL=http://localhost:3000
